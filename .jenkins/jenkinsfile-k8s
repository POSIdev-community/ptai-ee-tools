pipeline {
  agent {
    kubernetes {
      yamlFile '.jenkins/build-pod.yaml'
    }
  }
  parameters{
    string(name: 'JENKINS_VERSION', defaultValue: '2.387.3', description: 'Version of Jenkins that PT AI plugin is to support')
    string(name: 'TEAMCITY_VERSION', defaultValue: '2022.10', description: 'Version of TeamCity that PT AI plugin is to support')
  }
  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }
    stage('Validate parameters') {
      steps {
        script {
          def versionPattern = /^[0-9][0-9A-Za-z._-]*$/
          if (!(params.JENKINS_VERSION ==~ versionPattern)) {
            error("Invalid JENKINS_VERSION: '${params.JENKINS_VERSION}'. Expected a version like 2.387.3.")
          }
          if (!(params.TEAMCITY_VERSION ==~ versionPattern)) {
            error("Invalid TEAMCITY_VERSION: '${params.TEAMCITY_VERSION}'. Expected a version like 2022.10.")
          }
        }
      }
    }
    stage('Build image') {
      steps {
        container('gradle') {
          withEnv(["JENKINS_VERSION=${params.JENKINS_VERSION}", "TEAMCITY_VERSION=${params.TEAMCITY_VERSION}"]) {
            sh 'gradle build -P jenkinsVersion="$JENKINS_VERSION" -P teamcityVersion="$TEAMCITY_VERSION"'
          }
        }
      }
    }
    stage('Archive') {
      steps {
        archiveArtifacts artifacts: 'ptai-cli-plugin/build/libs/ptai-cli-plugin.jar, ptai-jenkins-plugin/build/libs/ptai-jenkins-plugin.hpi, ptai-teamcity-plugin/ptai-teamcity-plugin-server/build/distributions/ptai-teamcity-plugin.zip', followSymlinks: false
      }
    }
  }
}